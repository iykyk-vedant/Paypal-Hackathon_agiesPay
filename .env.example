# ==============================================================================
# AegisPay — Environment Configuration Template
# Autonomous Multi-Agent AI Fraud Shield for PayPal Commerce
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PayPal Developer Platform (Sandbox Credentials)
# ------------------------------------------------------------------------------
# Get your Sandbox credentials from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox

# ------------------------------------------------------------------------------
# 2. AI Reasoning Engine (Optional: Gemini 2.5 Flash)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. AegisPay Multi-Agent Risk Thresholds
# ------------------------------------------------------------------------------
# Minimum transaction amount ($ USD) to flag for deep AI investigation
FRAUD_THRESHOLD=1000.0

# Minimum risk score (0-10) to trigger autonomous mitigation (PayPal Refund / Void)
RISK_SCORE_THRESHOLD=7.0

# Interval in seconds between transaction stream evaluations
POLL_INTERVAL=5

# ------------------------------------------------------------------------------
# 4. Channel3 Product Intelligence & Fair Market Value (FMV)
# ------------------------------------------------------------------------------
# Sign up at: https://trychannel3.com/developers (Promo code PAYPAL for 20k free credits)
CHANNEL3_API_KEY=your_channel3_api_key_here

# ------------------------------------------------------------------------------
# 5. Elastic Cloud (Serverless Vector Search & ES|QL Engine)
# ------------------------------------------------------------------------------
# Elastic Cloud cluster endpoint and API key
ELASTIC_ENDPOINT=https://your-deployment.es.region.gcp.elastic.cloud:443
ELASTIC_API_KEY=your_elastic_api_key_here

# ------------------------------------------------------------------------------
# 6. KERNEL Cloud Browser Infrastructure (Mystery Shopper & 24fps Replay)
# ------------------------------------------------------------------------------
# Sign up at: https://www.kernel.sh/docs ($50 hackathon credits via Devpost)
KERNEL_API_KEY=your_kernel_api_key_here
KERNEL_API_BASE=https://api.onkernel.com/v1

# ------------------------------------------------------------------------------
# 7. Zapier MCP (Model Context Protocol — 9,000+ Apps Integration)
# ------------------------------------------------------------------------------
# Docs: https://docs.zapier.com/mcp/home | 14-day Pro trial free for hackathon
ZAPIER_MCP_SERVER_URL=https://mcp.zapier.com/v1
ZAPIER_NLA_API_KEY=your_zapier_nla_api_key_here
# Optional: Zapier Catch Hook URL for direct incident automation
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your_webhook_id/

# ------------------------------------------------------------------------------
# 8. Service Mesh URLs (Default to localhost for local dev)
# ------------------------------------------------------------------------------
ORCHESTRATOR_SERVICE_URL=http://localhost:8085
INVESTIGATION_AGENT_SERVICE_URL=http://localhost:8081
ACTUATOR_AGENT_SERVICE_URL=http://localhost:8082
