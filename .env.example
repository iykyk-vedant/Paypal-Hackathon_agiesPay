# ==============================================================================
# AegisPay — Environment Configuration
# Autonomous Multi-Agent Fraud Shield for PayPal Commerce
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Reasoning Engine (Required for Gemini Agents)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. PayPal Developer Platform (Sandbox Credentials)
# ------------------------------------------------------------------------------
# Get your Sandbox credentials from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox

# Optional: Webhook ID if using live PayPal webhook listener
# PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# ------------------------------------------------------------------------------
# 3. AegisPay Multi-Agent Risk Thresholds
# ------------------------------------------------------------------------------
# Minimum transaction amount ($ USD) to flag for deep AI investigation
FRAUD_THRESHOLD=1000.0

# Minimum risk score (0-10) to trigger autonomous mitigation (PayPal Refund / Hold)
RISK_SCORE_THRESHOLD=7

# Interval in seconds between transaction stream evaluations
POLL_INTERVAL=5

# ------------------------------------------------------------------------------
# 4. Service Mesh URLs (Default to localhost for local dev; Docker service names for container deploy)
# ------------------------------------------------------------------------------
GENAL_TOOLBOX_SERVICE_URL=http://localhost:5000
ORCHESTRATOR_SERVICE_URL=http://localhost:8080
INVESTIGATION_AGENT_SERVICE_URL=http://localhost:8081
ACTUATOR_AGENT_SERVICE_URL=http://localhost:8082
