{
  "$schema": "https://apimatic.io/schemas/context-plugin-v1.json",
  "plugin": {
    "name": "apimatic-paypal-context-plugin",
    "version": "1.0.0",
    "provider": "APIMatic",
    "api": "PayPal Developer Platform",
    "description": "APIMatic Context Plugin providing version-aware, type-safe API context for PayPal Checkout, Payments, and Disputes to AI agents in AegisPay.",
    "target_apis": [
      {
        "name": "Orders API",
        "version": "v2",
        "baseUrl": "https://api-m.sandbox.paypal.com/v2/checkout/orders",
        "capabilities": [
          "create_order",
          "authorize_order",
          "capture_order",
          "get_order_details"
        ],
        "context_files": [
          "orders_v2_schema.json"
        ]
      },
      {
        "name": "Payments API",
        "version": "v2",
        "baseUrl": "https://api-m.sandbox.paypal.com/v2/payments",
        "capabilities": [
          "refund_captured_payment",
          "void_authorized_payment",
          "get_capture_details"
        ]
      },
      {
        "name": "Disputes API",
        "version": "v1",
        "baseUrl": "https://api-m.sandbox.paypal.com/v1/customer/disputes",
        "capabilities": [
          "list_disputes",
          "get_dispute_details",
          "provide_evidence"
        ]
      },
      {
        "name": "Webhooks API",
        "version": "v1",
        "baseUrl": "https://api-m.sandbox.paypal.com/v1/notifications/webhooks-events",
        "subscribed_events": [
          "CHECKOUT.ORDER.APPROVED",
          "PAYMENT.CAPTURE.COMPLETED",
          "PAYMENT.CAPTURE.DENIED",
          "CUSTOMER.DISPUTE.CREATED"
        ]
      }
    ],
    "ai_agent_guidance": {
      "grounding_doctrine": "Agents must strictly format refund requests to /v2/payments/captures/{capture_id}/refund with valid UUID idempotency keys and avoid hallucinated parameters.",
      "actuator_enforcement": "Use void_authorized_payment for orders prior to settlement, and refund_captured_payment for settled captures."
    }
  }
}
